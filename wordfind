import sys



def main():
    if len(sys.argv) != 2 or sys.argv[1] == "":
        print("Usage: wordfind WORD", file=sys.stderr)
        return 1


    word = sys.argv[1]

    for line_number, line in enumerate(sys.stdin, start=1):
        if word in line:
            print(line_number)


    return 0



if __name__ == "__main__":
    sys.exit(main())
